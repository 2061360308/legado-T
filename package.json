{
  "name": "local-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "legado 本地 TXT 阅读器复刻（Tauri 2.x + Vue 3）",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vue-tsc --noEmit && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:web": "npm run build:wasm && vue-tsc --noEmit && vite build --mode web",
    "preview": "vite preview",
    "preview:web": "vite preview --mode web",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:resources": "node scripts/android-ui/parse-resources.mjs",
    "android:prefs": "node scripts/android-ui/parse-prefs.mjs",
    "android:menus": "node scripts/android-ui/parse-menu.mjs",
    "android:drawables": "node scripts/android-ui/convert-drawables.mjs",
    "android:layouts": "node scripts/android-ui/parse-layout.mjs",
    "android:generate": "node scripts/android-ui/generate-vue.mjs",
    "android:navigation": "node scripts/android-ui/extract-navigation.mjs",
    "android:binding": "node scripts/android-ui/extract-binding-usage.mjs",
    "android:validate": "node scripts/android-ui/validate-generated.mjs",
    "android:contract": "node scripts/android-ui/validate-ui-contract.mjs",
    "android:ui": "npm run android:resources && npm run android:prefs && npm run android:drawables && npm run android:layouts && npm run android:menus && npm run android:generate && npm run android:navigation && npm run android:binding && npm run android:validate && npm run android:contract"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "aws4fetch": "^1.0.20",
    "dexie": "^4.4.7",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^2.2.0",
    "qrcode": "^1.5.4",
    "spark-md5": "^3.0.2",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue": "^5.1.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
