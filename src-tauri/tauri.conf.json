{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地阅读器",
  "version": "0.1.0",
  "identifier": "com.localreader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "本地阅读器",
        "width": 420,
        "height": 760,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/defaultData/*": "defaultData/"
    }
  }
}