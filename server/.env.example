PORT=3000

# Defaults: 100 MB upload, unlimited download, 2 minutes waiting for upstream headers.
MAX_UPLOAD_BYTES=104857600
MAX_DOWNLOAD_BYTES=0
TIMEOUT_MS=120000
MAX_REDIRECTS=5

# Optional access control. When ALLOWED_HOSTS is empty, any public host is allowed.
ALLOWED_HOSTS=
ALLOW_PRIVATE_HOSTS=false
CORS_ORIGIN=*
PROXY_TOKEN=
