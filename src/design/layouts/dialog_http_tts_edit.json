{
  "tag": "FrameLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "padding": 16
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "vw_bg",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "background": "@drawable/shape_card_view",
        "orientation": "vertical"
      },
      "children": [
        {
          "tag": "Toolbar",
          "attrs": {
            "id": "tool_bar",
            "layout_width": "match_parent",
            "layout_height": "wrap_content"
          },
          "children": []
        },
        {
          "tag": "NestedScrollView",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": [
            {
              "tag": "LinearLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "orientation": "vertical"
              },
              "children": [
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "名称"
                  },
                  "children": [
                    {
                      "tag": "ThemeEditText",
                      "attrs": {
                        "id": "tv_name",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "url"
                  },
                  "children": [
                    {
                      "tag": "CodeView",
                      "attrs": {
                        "id": "tv_url",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "Content-Type"
                  },
                  "children": [
                    {
                      "tag": "CodeView",
                      "attrs": {
                        "id": "tv_content_type",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "并发率（concurrentRate）"
                  },
                  "children": [
                    {
                      "tag": "CodeView",
                      "attrs": {
                        "id": "tv_concurrent_rate",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "登录 URL(loginUrl)"
                  },
                  "children": [
                    {
                      "tag": "CodeView",
                      "attrs": {
                        "id": "tv_login_url",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "登录 UI（loginUi）"
                  },
                  "children": [
                    {
                      "tag": "CodeView",
                      "attrs": {
                        "id": "tv_login_ui",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "登录检查 JS（loginCheckJs）"
                  },
                  "children": [
                    {
                      "tag": "CodeView",
                      "attrs": {
                        "id": "tv_login_check_js",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "请求头（header）"
                  },
                  "children": [
                    {
                      "tag": "CodeView",
                      "attrs": {
                        "id": "tv_headers",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}