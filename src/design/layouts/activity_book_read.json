{
  "tag": "FrameLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "ReadView",
      "attrs": {
        "id": "read_view",
        "layout_width": "match_parent",
        "layout_height": "match_parent"
      },
      "children": []
    },
    {
      "tag": "View",
      "attrs": {
        "id": "text_menu_position",
        "layout_width": 0,
        "layout_height": 0,
        "visibility": "invisible"
      },
      "children": []
    },
    {
      "tag": "View",
      "attrs": {
        "id": "navigation_bar",
        "layout_width": "match_parent",
        "layout_height": 0,
        "background": "#EEEEEE",
        "layout_gravity": "bottom"
      },
      "children": []
    },
    {
      "tag": "ImageView",
      "attrs": {
        "id": "cursor_left",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "contentDescription": "文本选择开始位置",
        "src": "@drawable/ic_cursor_left",
        "visibility": "invisible"
      },
      "children": []
    },
    {
      "tag": "ImageView",
      "attrs": {
        "id": "cursor_right",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "contentDescription": "文本选择结束位置",
        "src": "@drawable/ic_cursor_right",
        "visibility": "invisible"
      },
      "children": []
    },
    {
      "tag": "ReadMenu",
      "attrs": {
        "id": "read_menu",
        "layout_width": "match_parent",
        "layout_height": "match_parent",
        "visibility": "gone"
      },
      "children": []
    },
    {
      "tag": "SearchMenu",
      "attrs": {
        "id": "search_menu",
        "layout_width": "match_parent",
        "layout_height": "match_parent",
        "visibility": "gone"
      },
      "children": []
    }
  ]
}