{
  "tag": "LinearLayout",
  "attrs": {
    "id": "root_view",
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": []
    },
    {
      "tag": "NoChildScrollNestedScrollView",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "id": "ll_content",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "orientation": "vertical",
            "padding": 10
          },
          "children": [
            {
              "tag": "TextInputLayout",
              "attrs": {
                "id": "til_name",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "hint": "替换规则名称"
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "et_name",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "id": "til_group",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "hint": "分组"
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "et_group",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "id": "til_replace_rule",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "hint": "替换规则"
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "et_replace_rule",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "id": "til_replace_to",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "hint": "替换为"
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "et_replace_to",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "id": "til_scope",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "hint": "替换范围，选填书名或者书源 URL"
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "et_scope",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "id": "til_exclude_scope",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "hint": "排除范围，选填书名或者书源 URL"
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "et_exclude_scope",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "id": "til_timeout",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "hint": "超时毫秒数"
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "et_timeout",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "LinearLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "orientation": "horizontal",
                "gravity": "center_vertical"
              },
              "children": [
                {
                  "tag": "ThemeCheckBox",
                  "attrs": {
                    "id": "cb_use_regex",
                    "layout_width": 0,
                    "layout_height": "wrap_content",
                    "layout_weight": "1",
                    "text": "使用正则表达式"
                  },
                  "children": []
                },
                {
                  "tag": "ImageView",
                  "attrs": {
                    "id": "iv_help",
                    "layout_width": 24,
                    "layout_height": 24,
                    "src": "@drawable/ic_help",
                    "tint": "#de000000",
                    "contentDescription": "帮助"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "LinearLayoutCompat",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content"
              },
              "children": [
                {
                  "tag": "ThemeCheckBox",
                  "attrs": {
                    "id": "cb_scope_title",
                    "layout_width": "wrap_content",
                    "layout_height": "wrap_content",
                    "checked": "false",
                    "text": "作用于标题"
                  },
                  "children": []
                },
                {
                  "tag": "ThemeCheckBox",
                  "attrs": {
                    "id": "cb_scope_content",
                    "layout_width": "wrap_content",
                    "layout_height": "wrap_content",
                    "layout_marginLeft": 10,
                    "checked": "true",
                    "text": "作用于正文"
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}