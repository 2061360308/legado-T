{
  "tag": "ConstraintLayout",
  "attrs": {
    "id": "cv_content",
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "background": "@drawable/bg_item_focused_on_tv"
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "orientation": "vertical",
        "paddingLeft": 8,
        "paddingTop": 8,
        "paddingRight": 8,
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": [
        {
          "tag": "ConstraintLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content"
          },
          "children": [
            {
              "tag": "CoverImageView",
              "attrs": {
                "id": "iv_cover",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "layout_margin": 8,
                "scaleType": "centerCrop",
                "src": "@drawable/image_cover_default",
                "layout_constraintTop_toTopOf": "parent"
              },
              "children": []
            },
            {
              "tag": "BadgeView",
              "attrs": {
                "id": "bv_unread",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "layout_gravity": "right",
                "layout_constraintRight_toRightOf": "parent",
                "layout_constraintTop_toTopOf": "parent"
              },
              "children": []
            },
            {
              "tag": "RotateLoading",
              "attrs": {
                "id": "rl_loading",
                "layout_width": 22,
                "layout_height": 22,
                "layout_gravity": "right",
                "visibility": "invisible",
                "layout_constraintRight_toRightOf": "parent",
                "layout_constraintTop_toTopOf": "parent"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_name",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginTop": 6,
            "ellipsize": "end",
            "gravity": "top|center_horizontal",
            "lines": "2",
            "text": "书名",
            "textColor": "#de000000",
            "textSize": 12
          },
          "children": []
        }
      ]
    },
    {
      "tag": "View",
      "attrs": {
        "id": "vw_foreground",
        "layout_width": "match_parent",
        "layout_height": 0,
        "background": "?android:attr/selectableItemBackground",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintTop_toTopOf": "parent",
        "layout_constraintVertical_bias": "0.0"
      },
      "children": []
    }
  ]
}