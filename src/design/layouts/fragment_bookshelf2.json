{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "SwipeRefreshLayout",
      "attrs": {
        "id": "refresh_layout",
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_constraintTop_toBottomOf": "@+id/title_bar",
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": [
        {
          "tag": "RecyclerViewAtPager2",
          "attrs": {
            "id": "rv_bookshelf",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_empty_msg",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "layout_margin": 16,
        "gravity": "center",
        "text": "书架还空着，先去搜索书籍或从发现里添加吧！",
        "visibility": "gone",
        "layout_constraintTop_toBottomOf": "@+id/title_bar",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    }
  ]
}