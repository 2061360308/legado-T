{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "titleBar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "lay_top",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "#FAFAFA",
        "gravity": "center_vertical",
        "minHeight": 36,
        "orientation": "horizontal",
        "padding": 8,
        "layout_constraintTop_toBottomOf": "@id/titleBar"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_path",
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_weight": "1",
            "gravity": "center_vertical",
            "singleLine": "true",
            "textColor": "#8a000000",
            "textSize": 13
          },
          "children": []
        },
        {
          "tag": "StrokeTextView",
          "attrs": {
            "id": "tv_go_back",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_gravity": "center",
            "layout_margin": 4,
            "gravity": "center",
            "paddingLeft": 16,
            "paddingRight": 16,
            "text": "上级",
            "textSize": 14
          },
          "children": []
        }
      ]
    },
    {
      "tag": "RefreshProgressBar",
      "attrs": {
        "id": "refresh_progress_bar",
        "layout_width": "match_parent",
        "layout_height": 2,
        "layout_constraintTop_toBottomOf": "@id/lay_top"
      },
      "children": []
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_weight": "1",
        "layout_constraintBottom_toTopOf": "@id/select_action_bar",
        "layout_constraintTop_toBottomOf": "@id/refresh_progress_bar"
      },
      "children": [
        {
          "tag": "FastScrollRecyclerView",
          "attrs": {
            "id": "recycler_view",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_empty_msg",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_gravity": "center",
            "layout_margin": 16,
            "gravity": "center",
            "text": "空",
            "visibility": "gone"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "SelectActionBar",
      "attrs": {
        "id": "select_action_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": []
    }
  ]
}