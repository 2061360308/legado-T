{
  "tag": "LinearLayout",
  "attrs": {
    "orientation": "vertical",
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "padding": 8,
    "background": "?android:attr/selectableItemBackground"
  },
  "children": [
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_chapter_name",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "padding": 4,
        "singleLine": "true"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_book_text",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "padding": 4,
        "textSize": 12,
        "singleLine": "true"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_content",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "padding": 4,
        "textSize": 12,
        "singleLine": "true"
      },
      "children": []
    }
  ]
}