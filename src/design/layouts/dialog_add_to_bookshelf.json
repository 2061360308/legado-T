{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content"
  },
  "children": [
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_title",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "padding": 18,
        "text": "放入书架",
        "textColor": "#de000000",
        "textSize": 16,
        "textStyle": "bold",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_cancel",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "padding": 16,
        "text": "取消",
        "textColor": "#8a000000",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintRight_toLeftOf": "@+id/tv_ok",
        "layout_constraintTop_toBottomOf": "@+id/book_info"
      },
      "children": []
    },
    {
      "tag": "ConstraintLayout",
      "attrs": {
        "id": "book_info",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "visibility": "invisible",
        "layout_constraintTop_toBottomOf": "@id/tv_title"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_name",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "textSize": 16,
            "layout_constraintTop_toTopOf": "parent"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_author",
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_marginLeft": 2,
            "layout_constraintLeft_toRightOf": "@+id/iv_author",
            "layout_constraintRight_toRightOf": "parent",
            "layout_constraintTop_toBottomOf": "@+id/tv_name"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_origin",
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_marginLeft": 2,
            "layout_constraintLeft_toRightOf": "@+id/iv_origin",
            "layout_constraintRight_toRightOf": "parent",
            "layout_constraintTop_toBottomOf": "@+id/tv_author"
          },
          "children": []
        },
        {
          "tag": "ImageView",
          "attrs": {
            "id": "iv_author",
            "layout_width": 18,
            "layout_height": 18,
            "contentDescription": "作者",
            "paddingRight": 2,
            "src": "@drawable/ic_author",
            "layout_constraintBottom_toBottomOf": "@+id/tv_author",
            "layout_constraintLeft_toLeftOf": "parent",
            "layout_constraintTop_toTopOf": "@id/tv_author",
            "tint": "#8A2C2C2C"
          },
          "children": []
        },
        {
          "tag": "ImageView",
          "attrs": {
            "id": "iv_origin",
            "layout_width": 18,
            "layout_height": 18,
            "contentDescription": "来源：%s",
            "paddingRight": 2,
            "src": "@drawable/ic_web_outline",
            "layout_constraintBottom_toBottomOf": "@+id/tv_origin",
            "layout_constraintLeft_toLeftOf": "parent",
            "layout_constraintTop_toTopOf": "@id/tv_origin",
            "tint": "#8A2C2C2C"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "RotateLoading",
      "attrs": {
        "id": "rotate_loading",
        "layout_width": 48,
        "layout_height": 48,
        "layout_constraintBottom_toBottomOf": "@+id/book_info",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toTopOf": "@id/book_info"
      },
      "children": []
    },
    {
      "tag": "AccentTextView",
      "attrs": {
        "id": "tv_ok",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "padding": 16,
        "text": "确认",
        "visibility": "gone",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toBottomOf": "@+id/book_info"
      },
      "children": []
    },
    {
      "tag": "AccentTextView",
      "attrs": {
        "id": "tv_read",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "padding": 16,
        "text": "阅读",
        "visibility": "invisible",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintLeft_toLeftOf": "parent"
      },
      "children": []
    }
  ]
}