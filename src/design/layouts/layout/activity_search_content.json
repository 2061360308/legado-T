{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "RefreshProgressBar",
      "attrs": {
        "id": "refresh_progress_bar",
        "layout_width": "match_parent",
        "layout_height": 2,
        "layout_constraintTop_toBottomOf": "@id/title_bar"
      },
      "children": []
    },
    {
      "tag": "FastScrollRecyclerView",
      "attrs": {
        "id": "recycler_view",
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_constraintBottom_toTopOf": "@+id/ll_search_base_info",
        "layout_constraintTop_toBottomOf": "@id/refresh_progress_bar"
      },
      "children": []
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "ll_search_base_info",
        "layout_width": "match_parent",
        "layout_height": 36,
        "background": "@color/background",
        "gravity": "center_vertical",
        "orientation": "horizontal",
        "paddingLeft": 10,
        "paddingRight": 10,
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_current_search_info",
            "layout_width": 0,
            "layout_height": "match_parent",
            "layout_weight": "1",
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "ellipsize": "middle",
            "gravity": "center_vertical",
            "paddingLeft": 10,
            "paddingRight": 10,
            "singleLine": "true",
            "textColor": "#de000000",
            "textSize": 12
          },
          "children": []
        },
        {
          "tag": "Space",
          "attrs": {
            "layout_width": 20,
            "layout_height": 1
          },
          "children": []
        },
        {
          "tag": "AppCompatImageView",
          "attrs": {
            "id": "iv_search_content_top",
            "layout_width": 36,
            "layout_height": "match_parent",
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "contentDescription": "滚动到顶部",
            "src": "ic_arrow_drop_up",
            "tint": "#de000000"
          },
          "children": []
        },
        {
          "tag": "AppCompatImageView",
          "attrs": {
            "id": "iv_search_content_bottom",
            "layout_width": 36,
            "layout_height": "match_parent",
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "contentDescription": "滚动到底部",
            "src": "ic_arrow_drop_down",
            "tint": "#de000000"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "FloatingActionButton",
      "attrs": {
        "id": "fb_stop",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_margin": 16,
        "src": "ic_stop_black_24dp",
        "visibility": "invisible",
        "contentDescription": "停止",
        "layout_constraintBottom_toTopOf": "@+id/ll_search_base_info",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    }
  ]
}