{
  "tag": "FrameLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "padding": 16
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "vw_bg",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "background": "shape_card_view",
        "orientation": "vertical"
      },
      "children": [
        {
          "tag": "Toolbar",
          "attrs": {
            "id": "tool_bar",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "title": "书签"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_chapter_name",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "paddingLeft": 16,
            "paddingRight": 16,
            "textColor": "#de000000"
          },
          "children": []
        },
        {
          "tag": "NestedScrollView",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": 0,
            "layout_weight": "1"
          },
          "children": [
            {
              "tag": "LinearLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "orientation": "vertical",
                "padding": 16
              },
              "children": [
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "paddingTop": 3
                  },
                  "children": [
                    {
                      "tag": "ThemeEditText",
                      "attrs": {
                        "id": "edit_book_text",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content",
                        "hint": "内容"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "paddingTop": 3
                  },
                  "children": [
                    {
                      "tag": "ThemeEditText",
                      "attrs": {
                        "id": "edit_content",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content",
                        "hint": "备注内容"
                      },
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tag": "FlexboxLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "paddingLeft": 12,
            "paddingRight": 12
          },
          "children": [
            {
              "tag": "AccentTextView",
              "attrs": {
                "id": "tv_footer_left",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 12,
                "text": "删除",
                "visibility": "invisible"
              },
              "children": []
            },
            {
              "tag": "LinearLayout",
              "attrs": {
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "orientation": "horizontal"
              },
              "children": [
                {
                  "tag": "AccentTextView",
                  "attrs": {
                    "id": "tv_cancel",
                    "layout_width": "wrap_content",
                    "layout_height": "wrap_content",
                    "padding": 12,
                    "text": "取消"
                  },
                  "children": []
                },
                {
                  "tag": "AccentTextView",
                  "attrs": {
                    "id": "tv_ok",
                    "layout_width": "wrap_content",
                    "layout_height": "wrap_content",
                    "padding": 12,
                    "text": "确认"
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}