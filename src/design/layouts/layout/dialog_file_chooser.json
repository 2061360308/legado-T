{
  "tag": "LinearLayout",
  "attrs": {
    "orientation": "vertical",
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "background": "@color/background"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": []
    },
    {
      "tag": "RecyclerView",
      "attrs": {
        "id": "rv_path",
        "layout_width": "match_parent",
        "layout_height": 24,
        "paddingLeft": 10,
        "paddingRight": 10,
        "background": "@color/background_card"
      },
      "children": []
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_weight": "1",
        "background": "@color/background_card"
      },
      "children": [
        {
          "tag": "RecyclerView",
          "attrs": {
            "id": "rv_file",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_empty",
            "layout_width": "match_parent",
            "layout_height": "match_parent",
            "gravity": "center",
            "visibility": "gone"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "AccentBgTextView",
      "attrs": {
        "id": "tv_ok",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "padding": 10,
        "layout_margin": 3,
        "text": "确认",
        "gravity": "center"
      },
      "children": []
    }
  ]
}