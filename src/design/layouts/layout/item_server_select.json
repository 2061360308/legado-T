{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "background": "@color/background",
    "padding": 8,
    "gravity": "center_vertical",
    "orientation": "horizontal"
  },
  "children": [
    {
      "tag": "ThemeRadioButton",
      "attrs": {
        "id": "rb_server",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "layout_weight": "1",
        "singleLine": "true",
        "textColor": "#de000000"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_edit",
        "layout_width": 36,
        "layout_height": 36,
        "layout_gravity": "center",
        "background": "?android:attr/selectableItemBackgroundBorderless",
        "contentDescription": "编辑",
        "padding": 6,
        "src": "ic_edit",
        "tint": "#de000000"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_delete",
        "layout_width": 36,
        "layout_height": 36,
        "padding": 6,
        "background": "?attr/selectableItemBackgroundBorderless",
        "src": "ic_outline_delete",
        "tint": "#de000000",
        "contentDescription": "删除"
      },
      "children": []
    }
  ]
}