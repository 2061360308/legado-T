{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "title": "关于"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "id": "ll_about",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "background": "shape_card_view",
            "orientation": "vertical",
            "layout_margin": 6,
            "padding": 10
          },
          "children": [
            {
              "tag": "TextView",
              "attrs": {
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "layout_gravity": "center",
                "text": "阅读",
                "textSize": 20,
                "textStyle": "bold"
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_app_summary",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "text": "\\u3000\\u3000这是一款使用 Kotlin 全新开发的开源的阅读软件，欢迎您的加入。"
              },
              "children": []
            }
          ]
        }
      ]
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "id": "fl_fragment",
        "layout_width": "match_parent",
        "layout_height": "match_parent"
      },
      "children": []
    }
  ]
}