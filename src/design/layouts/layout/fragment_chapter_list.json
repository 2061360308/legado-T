{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent"
  },
  "children": [
    {
      "tag": "FastScrollRecyclerView",
      "attrs": {
        "id": "recycler_view",
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_constraintBottom_toTopOf": "@+id/ll_chapter_base_info",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "ll_chapter_base_info",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "@color/background",
        "gravity": "center_vertical",
        "orientation": "horizontal",
        "paddingLeft": 10,
        "paddingRight": 10,
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_current_chapter_info",
            "layout_width": 0,
            "layout_height": 36,
            "layout_weight": "1",
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "ellipsize": "middle",
            "gravity": "center_vertical",
            "paddingLeft": 10,
            "paddingRight": 10,
            "singleLine": "true",
            "textColor": "#de000000",
            "textSize": 12
          },
          "children": []
        },
        {
          "tag": "AppCompatImageView",
          "attrs": {
            "id": "iv_chapter_top",
            "layout_width": 36,
            "layout_height": 36,
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "contentDescription": "滚动到顶部",
            "src": "ic_arrow_drop_up",
            "tint": "#de000000"
          },
          "children": []
        },
        {
          "tag": "AppCompatImageView",
          "attrs": {
            "id": "iv_chapter_bottom",
            "layout_width": 36,
            "layout_height": 36,
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "contentDescription": "滚动到底部",
            "src": "ic_arrow_drop_down",
            "tint": "#de000000"
          },
          "children": []
        }
      ]
    }
  ]
}