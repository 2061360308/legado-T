{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "title": "校验设置"
      },
      "children": []
    },
    {
      "tag": "TextInputLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingLeft": 12,
        "paddingRight": 12,
        "paddingTop": 3
      },
      "children": [
        {
          "tag": "ThemeEditText",
          "attrs": {
            "id": "check_source_timeout",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "hint": "单个书源校验超时（秒）"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "AccentTextView",
      "attrs": {
        "paddingLeft": 12,
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "text": "校验项目"
      },
      "children": []
    },
    {
      "tag": "FlexboxLayout",
      "attrs": {
        "layout_width": "match_parent",
        "paddingLeft": 12,
        "paddingRight": 12,
        "layout_height": "wrap_content"
      },
      "children": [
        {
          "tag": "ThemeCheckBox",
          "attrs": {
            "id": "check_search",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "text": "搜索"
          },
          "children": []
        },
        {
          "tag": "ThemeCheckBox",
          "attrs": {
            "id": "check_discovery",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "text": "发现"
          },
          "children": []
        },
        {
          "tag": "ThemeCheckBox",
          "attrs": {
            "id": "check_info",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "text": "详情"
          },
          "children": []
        },
        {
          "tag": "ThemeCheckBox",
          "attrs": {
            "id": "check_category",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "text": "目录"
          },
          "children": []
        },
        {
          "tag": "ThemeCheckBox",
          "attrs": {
            "id": "check_content",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "text": "正文"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "FlexboxLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingLeft": 12,
        "paddingRight": 12
      },
      "children": [
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_cancel",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 12,
            "text": "取消"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_ok",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 12,
            "text": "确认"
          },
          "children": []
        }
      ]
    }
  ]
}