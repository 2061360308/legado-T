{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content"
  },
  "children": [
    {
      "tag": "TabLayout",
      "attrs": {
        "id": "tab_layout",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingBottom": 16,
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "ScrollTextView",
      "attrs": {
        "id": "tv_dict",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "padding": 16,
        "textColor": "#8a000000",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintTop_toBottomOf": "@id/tab_layout"
      },
      "children": []
    },
    {
      "tag": "RotateLoading",
      "attrs": {
        "id": "rotate_loading",
        "layout_width": 60,
        "layout_height": 60,
        "layout_gravity": "center",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toBottomOf": "@id/tab_layout"
      },
      "children": []
    }
  ]
}