{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "padding": 16
  },
  "children": [
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_name",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "singleLine": "true",
        "textColor": "#de000000",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toLeftOf": "@+id/iv_download",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_author",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "singleLine": "true",
        "textColor": "#de000000",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toLeftOf": "@+id/iv_download",
        "layout_constraintTop_toBottomOf": "@+id/tv_name"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_download",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "singleLine": "true",
        "textColor": "#8a000000",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toLeftOf": "@+id/iv_download",
        "layout_constraintTop_toBottomOf": "@id/tv_author"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_export",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "background": "?attr/selectableItemBackground",
        "padding": 10,
        "text": "导出",
        "textColor": "#de000000",
        "layout_constraintBottom_toBottomOf": "@+id/tv_download",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toTopOf": "@id/tv_name"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_msg",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "textColor": "#8a000000",
        "visibility": "gone",
        "layout_constraintTop_toBottomOf": "@id/tv_download"
      },
      "children": []
    },
    {
      "tag": "ImageView",
      "attrs": {
        "id": "iv_download",
        "layout_width": 36,
        "layout_height": 36,
        "background": "?attr/selectableItemBackgroundBorderless",
        "contentDescription": "开始",
        "padding": 6,
        "src": "ic_play_24dp",
        "layout_constraintBottom_toBottomOf": "@+id/tv_download",
        "layout_constraintRight_toLeftOf": "@+id/tv_export",
        "layout_constraintTop_toTopOf": "@id/tv_name",
        "tint": "#de000000"
      },
      "children": []
    },
    {
      "tag": "ThemeProgressBar",
      "attrs": {
        "id": "progress_export",
        "style": "?android:attr/progressBarStyleHorizontal",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "visibility": "gone",
        "layout_constraintTop_toBottomOf": "@id/tv_download"
      },
      "children": []
    }
  ]
}