{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "title": "封面设置"
      },
      "children": []
    },
    {
      "tag": "NestedScrollView",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_weight": "1"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "orientation": "vertical",
            "padding": 16
          },
          "children": [
            {
              "tag": "ThemeCheckBox",
              "attrs": {
                "id": "cb_enable",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "text": "启用"
              },
              "children": []
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "paddingTop": 3
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "edit_search_url",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "搜索地址（url）"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "paddingTop": 3
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "edit_cover_url_rule",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "封面规则（coverUrl）"
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tag": "FlexboxLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingLeft": 12,
        "paddingRight": 12
      },
      "children": [
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_footer_left",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 12,
            "text": "默认"
          },
          "children": []
        },
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_cancel",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 12,
                "text": "取消",
                "textColor": "#8a000000"
              },
              "children": []
            },
            {
              "tag": "AccentTextView",
              "attrs": {
                "id": "tv_ok",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 12,
                "text": "确认"
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}