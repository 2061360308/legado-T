{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "background": "@color/background"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "@color/background_menu",
        "layout_constraintTop_toTopOf": "parent",
        "title": "搜索范围"
      },
      "children": []
    },
    {
      "tag": "RadioGroup",
      "attrs": {
        "id": "rg_scope",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "gravity": "center",
        "orientation": "horizontal",
        "layout_constraintTop_toBottomOf": "@+id/tool_bar"
      },
      "children": [
        {
          "tag": "ThemeRadioNoButton",
          "attrs": {
            "id": "rb_group",
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_margin": 4,
            "layout_weight": "1",
            "gravity": "center",
            "padding": 5,
            "singleLine": "true",
            "checked": "true",
            "text": "分组"
          },
          "children": []
        },
        {
          "tag": "ThemeRadioNoButton",
          "attrs": {
            "id": "rb_source",
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_margin": 4,
            "layout_weight": "1",
            "gravity": "center",
            "padding": 5,
            "singleLine": "true",
            "text": "书源"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "FastScrollRecyclerView",
      "attrs": {
        "id": "recycler_view",
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_constraintBottom_toTopOf": "@+id/ll_bottom_bar",
        "layout_constraintTop_toBottomOf": "@+id/rg_scope"
      },
      "children": []
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "ll_bottom_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "@color/background",
        "gravity": "center_vertical",
        "orientation": "horizontal",
        "paddingLeft": 10,
        "paddingRight": 10,
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": [
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_all_source",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginRight": 16,
            "padding": 12,
            "text": "全部书源"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_ok",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginRight": 16,
            "padding": 12,
            "text": "确认"
          },
          "children": []
        },
        {
          "tag": "Space",
          "attrs": {
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_weight": "1"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_cancel",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginRight": 16,
            "padding": 12,
            "text": "取消",
            "textColor": "#8a000000"
          },
          "children": []
        }
      ]
    }
  ]
}