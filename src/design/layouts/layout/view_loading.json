{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "wrap_content",
    "layout_height": "wrap_content",
    "gravity": "center_horizontal",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "ContentLoadingProgressBar",
      "attrs": {
        "id": "loading_progress",
        "layout_width": 48,
        "layout_height": 48,
        "style": "@style/Widget.AppCompat.ProgressBar"
      },
      "children": []
    },
    {
      "tag": "AppCompatTextView",
      "attrs": {
        "id": "tv_loading_message",
        "style": "@style/Style.Text.Second.Normal.Wrap",
        "paddingTop": 16,
        "text": "正在加载"
      },
      "children": []
    }
  ]
}