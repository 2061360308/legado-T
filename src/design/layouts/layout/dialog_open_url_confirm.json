{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "background": "shape_card_view",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "title": "跳转确认"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "message",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "padding": 16,
        "textColor": "#de000000",
        "textSize": 16
      },
      "children": []
    },
    {
      "tag": "FlexboxLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": [
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "btn_negative",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 16,
            "text": "取消"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "btn_positive",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 16,
            "text": "确认"
          },
          "children": []
        }
      ]
    }
  ]
}