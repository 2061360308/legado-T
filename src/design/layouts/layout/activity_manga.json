{
  "tag": "FrameLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent"
  },
  "children": [
    {
      "tag": "WebtoonFrame",
      "attrs": {
        "id": "webtoon_frame",
        "layout_width": "match_parent",
        "layout_height": "match_parent"
      },
      "children": [
        {
          "tag": "WebtoonRecyclerView",
          "attrs": {
            "id": "recycler_view",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "ReaderInfoBarView",
      "attrs": {
        "id": "infobar",
        "layout_width": "match_parent",
        "layout_height": 20,
        "layout_gravity": "bottom",
        "layout_marginBottom": 10,
        "paddingStart": 10,
        "paddingEnd": 10,
        "visibility": "gone"
      },
      "children": []
    },
    {
      "tag": "MangaMenu",
      "attrs": {
        "id": "manga_menu",
        "layout_width": "match_parent",
        "layout_height": "match_parent",
        "visibility": "gone"
      },
      "children": []
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "id": "fl_loading",
        "layout_width": "match_parent",
        "layout_height": "match_parent",
        "background": "@color/background"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "id": "ll_loading",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_gravity": "center",
            "gravity": "center",
            "orientation": "vertical"
          },
          "children": [
            {
              "tag": "ProgressBar",
              "attrs": {
                "id": "pb_loading",
                "style": "@style/Widget.Material3.CircularProgressIndicator.Small",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content"
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_loading_message",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "layout_marginTop": 10,
                "text": "加载中…",
                "textColor": "#de000000"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "LinearLayout",
          "attrs": {
            "id": "ll_retry",
            "layout_width": "match_parent",
            "layout_height": "match_parent",
            "gravity": "center",
            "orientation": "vertical",
            "visibility": "gone"
          },
          "children": [
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_msg",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "textColor": "#de000000"
              },
              "children": []
            },
            {
              "tag": "AccentTextView",
              "attrs": {
                "id": "tv_retry",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "layout_margin": 16,
                "text": "重新加载",
                "textSize": 18
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}