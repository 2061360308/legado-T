{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "title": "规则订阅"
      },
      "children": []
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "match_parent"
      },
      "children": [
        {
          "tag": "RecyclerView",
          "attrs": {
            "id": "recycler_view",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_empty_msg",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_gravity": "center",
            "layout_margin": 16,
            "gravity": "center",
            "text": "添加大佬们提供的规则导入地址\\n添加后点击可导入规则",
            "visibility": "gone",
            "layout_constraintBottom_toBottomOf": "parent",
            "layout_constraintLeft_toLeftOf": "parent",
            "layout_constraintRight_toRightOf": "parent",
            "layout_constraintTop_toBottomOf": "@+id/title_bar"
          },
          "children": []
        }
      ]
    }
  ]
}