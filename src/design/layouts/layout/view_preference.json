{
  "tag": "LinearLayout",
  "attrs": {
    "background": "bg_prefs_color",
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "paddingLeft": 16,
    "paddingTop": 10,
    "paddingRight": 16,
    "paddingBottom": 10,
    "minHeight": 60,
    "orientation": "horizontal",
    "gravity": "center_vertical"
  },
  "children": [
    {
      "tag": "ImageView",
      "attrs": {
        "id": "preference_icon",
        "layout_marginRight": 16,
        "scaleType": "fitCenter",
        "visibility": "visible",
        "paddingTop": 1,
        "layout_width": 24,
        "layout_height": 24
      },
      "children": []
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "orientation": "vertical",
        "layout_weight": "1.0",
        "layout_width": 0,
        "layout_height": "wrap_content"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "preference_title",
            "singleLine": "true",
            "textSize": 16,
            "text": "标题",
            "textColor": "#de000000",
            "layout_width": "match_parent",
            "layout_height": "wrap_content"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "preference_desc",
            "textSize": 14,
            "textColor": "#8A2C2C2C",
            "text": "预设一",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginTop": 8
          },
          "children": []
        }
      ]
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "id": "preference_widget",
        "orientation": "vertical",
        "layout_gravity": "center",
        "layout_marginLeft": 8,
        "layout_marginTop": 8,
        "layout_marginBottom": 8,
        "visibility": "gone",
        "gravity": "right|center_vertical",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content"
      },
      "children": []
    }
  ]
}