{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "background": "?android:attr/selectableItemBackground",
    "gravity": "center_vertical",
    "orientation": "horizontal",
    "padding": 5
  },
  "children": [
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_font",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_weight": "1",
        "padding": 5,
        "textColor": "#de000000"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_checked",
        "layout_width": 24,
        "layout_height": 24,
        "src": "ic_check",
        "visibility": "invisible",
        "tint": "#de000000"
      },
      "children": []
    }
  ]
}