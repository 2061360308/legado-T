{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "padding": 12
  },
  "children": [
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_name",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "padding": 3,
        "textSize": 16,
        "textColor": "#de000000",
        "layout_constraintTop_toTopOf": "parent",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toLeftOf": "@id/iv_edit"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_url",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "padding": 3,
        "textSize": 12,
        "textColor": "#8a000000",
        "ellipsize": "middle",
        "singleLine": "true",
        "layout_constraintTop_toBottomOf": "@+id/tv_name",
        "layout_constraintLeft_toRightOf": "@+id/tv_type",
        "layout_constraintRight_toLeftOf": "@+id/iv_edit"
      },
      "children": []
    },
    {
      "tag": "AccentBgTextView",
      "attrs": {
        "id": "tv_type",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "padding": 3,
        "textSize": 12,
        "layout_constraintTop_toBottomOf": "@+id/tv_name",
        "layout_constraintLeft_toLeftOf": "parent"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_edit",
        "layout_width": 36,
        "layout_height": 36,
        "layout_gravity": "center",
        "background": "?attr/selectableItemBackgroundBorderless",
        "contentDescription": "编辑",
        "padding": 6,
        "src": "ic_edit",
        "tint": "#de000000",
        "layout_constraintRight_toLeftOf": "@id/iv_menu_more",
        "layout_constraintTop_toTopOf": "parent",
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_menu_more",
        "layout_width": 36,
        "layout_height": 36,
        "background": "?attr/selectableItemBackgroundBorderless",
        "padding": 6,
        "src": "ic_more_vert",
        "tint": "#de000000",
        "contentDescription": "更多菜单",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toTopOf": "parent",
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": []
    }
  ]
}