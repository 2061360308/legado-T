{
  "tag": "FrameLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "padding": 16
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "background": "shape_card_view",
        "orientation": "vertical"
      },
      "children": [
        {
          "tag": "Toolbar",
          "attrs": {
            "id": "tool_bar",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "background": "@color/background_menu",
            "title": "Set variable"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "padding": 3,
            "text": "variable"
          },
          "children": []
        },
        {
          "tag": "ThemeEditText",
          "attrs": {
            "id": "tv_variable",
            "layout_width": "match_parent",
            "layout_height": "wrap_content"
          },
          "children": []
        },
        {
          "tag": "NestedScrollView",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content"
          },
          "children": [
            {
              "tag": "LinearLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "orientation": "vertical"
              },
              "children": [
                {
                  "tag": "AccentTextView",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "padding": 3,
                    "text": "变量说明(variableComment)"
                  },
                  "children": []
                },
                {
                  "tag": "TextView",
                  "attrs": {
                    "id": "tv_comment",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "padding": 3,
                    "textColor": "#8a000000"
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}