{
  "tag": "LinearLayout",
  "attrs": {
    "orientation": "vertical",
    "layout_width": "match_parent",
    "layout_height": "match_parent"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": []
    },
    {
      "tag": "RecyclerView",
      "attrs": {
        "id": "recycler_view",
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_weight": "1"
      },
      "children": []
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": [
        {
          "tag": "Space",
          "attrs": {
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_weight": "1"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_cancel",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginRight": 16,
            "padding": 12,
            "text": "取消"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_ok",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginRight": 16,
            "padding": 12,
            "text": "确认"
          },
          "children": []
        }
      ]
    }
  ]
}