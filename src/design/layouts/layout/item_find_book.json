{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "gravity": "center",
    "orientation": "vertical",
    "background": "bg_item_focused_on_tv"
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "ll_title",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingLeft": 10,
        "paddingRight": 10,
        "paddingTop": 6,
        "paddingBottom": 6,
        "background": "bg_find_book_group",
        "orientation": "horizontal",
        "gravity": "center_vertical"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_name",
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_weight": "1",
            "textColor": "#de000000"
          },
          "children": []
        },
        {
          "tag": "RotateLoading",
          "attrs": {
            "id": "rotate_loading",
            "layout_width": 20,
            "layout_height": 20,
            "visibility": "gone",
            "layout_gravity": "center",
            "layout_marginRight": 4
          },
          "children": []
        },
        {
          "tag": "ImageView",
          "attrs": {
            "id": "iv_status",
            "layout_width": 20,
            "layout_height": 20,
            "src": "ic_arrow_right",
            "tint": "#8a000000"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingLeft": 8,
        "paddingRight": 8,
        "layout_gravity": "center"
      },
      "children": [
        {
          "tag": "FlexboxLayout",
          "attrs": {
            "id": "flexbox",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "padding": 3,
            "layout_marginTop": 8,
            "visibility": "gone"
          },
          "children": []
        }
      ]
    }
  ]
}