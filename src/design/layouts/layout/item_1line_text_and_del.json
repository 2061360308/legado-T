{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "gravity": "center_vertical",
    "orientation": "horizontal",
    "padding": 6
  },
  "children": [
    {
      "tag": "TextView",
      "attrs": {
        "id": "text_view",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_weight": "1",
        "singleLine": "true",
        "textColor": "#de000000"
      },
      "children": []
    },
    {
      "tag": "ImageView",
      "attrs": {
        "id": "iv_delete",
        "layout_width": 24,
        "layout_height": 24,
        "contentDescription": "删除",
        "src": "ic_clear_all",
        "visibility": "gone",
        "tint": "#de000000"
      },
      "children": []
    }
  ]
}