{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "background": "bg_item_focused_on_tv",
    "padding": 16
  },
  "children": [
    {
      "tag": "FilletImageView",
      "attrs": {
        "id": "iv_icon",
        "layout_width": 50,
        "layout_height": 50,
        "scaleType": "centerCrop",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_name",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_marginTop": 16,
        "ellipsize": "end",
        "gravity": "top|center_horizontal",
        "lines": "2",
        "textColor": "#8a000000",
        "textSize": 13,
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toBottomOf": "@+id/iv_icon"
      },
      "children": []
    }
  ]
}