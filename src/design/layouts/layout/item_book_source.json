{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "background": "?android:attr/selectableItemBackground",
    "padding": 16
  },
  "children": [
    {
      "tag": "AccentTextView",
      "attrs": {
        "id": "tv_host_text",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_marginTop": -12,
        "layout_marginBottom": 16,
        "singleLine": "true",
        "textSize": 16,
        "visibility": "gone",
        "layout_constraintBottom_toTopOf": "@id/barrier",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "Barrier",
      "attrs": {
        "id": "barrier",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content"
      },
      "children": []
    },
    {
      "tag": "ThemeCheckBox",
      "attrs": {
        "id": "cb_book_source",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "singleLine": "true",
        "textColor": "#de000000",
        "layout_constraintBottom_toTopOf": "@id/iv_debug_text",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toLeftOf": "@id/swt_enabled",
        "layout_constraintTop_toBottomOf": "@id/barrier"
      },
      "children": []
    },
    {
      "tag": "ThemeSwitch",
      "attrs": {
        "id": "swt_enabled",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_marginRight": 6,
        "layout_constraintBottom_toTopOf": "@id/iv_debug_text",
        "layout_constraintRight_toLeftOf": "@id/iv_edit",
        "layout_constraintTop_toBottomOf": "@id/barrier"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_edit",
        "layout_width": 36,
        "layout_height": 36,
        "layout_gravity": "center",
        "background": "?android:attr/selectableItemBackgroundBorderless",
        "contentDescription": "编辑",
        "padding": 6,
        "src": "ic_edit",
        "tint": "#de000000",
        "layout_constraintBottom_toTopOf": "@id/iv_debug_text",
        "layout_constraintRight_toLeftOf": "@id/iv_menu_more",
        "layout_constraintTop_toBottomOf": "@id/barrier"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_menu_more",
        "layout_width": 36,
        "layout_height": 36,
        "background": "?attr/selectableItemBackgroundBorderless",
        "contentDescription": "更多菜单",
        "padding": 6,
        "src": "ic_more_vert",
        "tint": "#de000000",
        "layout_constraintBottom_toTopOf": "@id/iv_debug_text",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toBottomOf": "@id/barrier"
      },
      "children": []
    },
    {
      "tag": "CircleImageView",
      "attrs": {
        "id": "iv_explore",
        "layout_width": 8,
        "layout_height": 8,
        "scaleType": "centerCrop",
        "src": "@color/md_green_600",
        "layout_constraintRight_toRightOf": "@id/iv_menu_more",
        "layout_constraintTop_toTopOf": "@id/iv_menu_more"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "iv_debug_text",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_marginTop": 6,
        "singleLine": "true",
        "visibility": "gone",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toLeftOf": "@id/iv_progressBar",
        "layout_constraintTop_toBottomOf": "@id/cb_book_source"
      },
      "children": []
    },
    {
      "tag": "ThemeProgressBar",
      "attrs": {
        "id": "iv_progressBar",
        "layout_width": 25,
        "layout_height": 25,
        "layout_gravity": "start|center_vertical",
        "visibility": "gone",
        "layout_constraintBottom_toBottomOf": "@id/iv_debug_text",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toTopOf": "@id/iv_debug_text"
      },
      "children": []
    }
  ]
}