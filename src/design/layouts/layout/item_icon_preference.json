{
  "tag": "RelativeLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "?android:attr/listPreferredItemHeight",
    "padding": 6
  },
  "children": [
    {
      "tag": "ImageView",
      "attrs": {
        "id": "icon",
        "layout_width": "wrap_content",
        "layout_height": "match_parent",
        "contentDescription": "ICON",
        "padding": 10
      },
      "children": []
    },
    {
      "tag": "CheckedTextView",
      "attrs": {
        "id": "label",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "paddingRight": 10,
        "layout_alignParentEnd": "true",
        "layout_toRightOf": "@+id/icon",
        "ellipsize": "marquee",
        "gravity": "center_vertical",
        "minHeight": "?android:attr/listPreferredItemHeight",
        "singleLine": "true",
        "textColor": "?android:attr/textColorAlertDialogListItem"
      },
      "children": []
    }
  ]
}