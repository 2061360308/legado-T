{
  "tag": "ConstraintLayout",
  "attrs": {
    "id": "vw_menu_root",
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "View",
      "attrs": {
        "id": "vw_menu_bg",
        "layout_width": "match_parent",
        "layout_height": "match_parent",
        "contentDescription": "内容"
      },
      "children": []
    },
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": [
        {
          "tag": "ConstraintLayout",
          "attrs": {
            "id": "title_bar_addition",
            "layout_width": "match_parent",
            "layout_height": "wrap_content"
          },
          "children": [
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_chapter_name",
                "layout_width": 0,
                "layout_height": "wrap_content",
                "paddingLeft": 10,
                "paddingRight": 10,
                "singleLine": "true",
                "visibility": "gone",
                "layout_constraintLeft_toLeftOf": "parent",
                "layout_constraintRight_toLeftOf": "@+id/tv_source_action",
                "layout_constraintTop_toTopOf": "parent"
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_chapter_url",
                "layout_width": 0,
                "layout_height": "wrap_content",
                "paddingLeft": 10,
                "paddingRight": 10,
                "singleLine": "true",
                "visibility": "gone",
                "layout_constraintLeft_toLeftOf": "parent",
                "layout_constraintRight_toLeftOf": "@+id/tv_source_action",
                "layout_constraintTop_toBottomOf": "@+id/tv_chapter_name"
              },
              "children": []
            },
            {
              "tag": "AccentBgTextView",
              "attrs": {
                "id": "tv_source_action",
                "layout_width": "wrap_content",
                "layout_height": 0,
                "layout_margin": 1,
                "gravity": "center",
                "paddingLeft": 6,
                "paddingRight": 6,
                "text": "书源",
                "layout_constraintBottom_toBottomOf": "@+id/tv_chapter_url",
                "layout_constraintRight_toRightOf": "parent",
                "layout_constraintTop_toTopOf": "parent"
              },
              "children": []
            }
          ]
        }
      ]
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "bottom_menu",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "@color/background_menu",
        "orientation": "vertical",
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginLeft": 20,
            "layout_marginTop": 10,
            "layout_marginRight": 20,
            "layout_marginBottom": 10,
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_pre",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "layout_marginStart": 10,
                "layout_marginEnd": 10,
                "background": "?android:attr/selectableItemBackgroundBorderless",
                "paddingTop": 10,
                "paddingBottom": 10,
                "text": "上一章",
                "textColor": "#de000000",
                "textSize": 14
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_next",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "layout_marginStart": 10,
                "layout_marginEnd": 10,
                "background": "?android:attr/selectableItemBackgroundBorderless",
                "paddingTop": 10,
                "paddingBottom": 10,
                "text": "下一章",
                "textColor": "#de000000",
                "textSize": 14
              },
              "children": []
            },
            {
              "tag": "ThemeSeekBar",
              "attrs": {
                "id": "seek_read_page",
                "layout_width": 0,
                "layout_height": 25,
                "layout_gravity": "center_vertical",
                "layout_weight": "1"
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}