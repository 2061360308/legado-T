{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "titleBar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "RecyclerView",
      "attrs": {
        "id": "rv_path",
        "layout_width": "match_parent",
        "layout_height": 24,
        "background": "@color/background_card",
        "paddingLeft": 10,
        "paddingRight": 10,
        "layout_constraintTop_toBottomOf": "@+id/titleBar"
      },
      "children": []
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_weight": "1",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintTop_toBottomOf": "@id/rv_path"
      },
      "children": [
        {
          "tag": "FastScrollRecyclerView",
          "attrs": {
            "id": "recycler_view",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_empty_msg",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_gravity": "center",
            "layout_margin": 16,
            "gravity": "center",
            "text": "空",
            "visibility": "gone"
          },
          "children": []
        }
      ]
    }
  ]
}