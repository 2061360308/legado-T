{
  "tag": "NestedScrollView",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "paddingLeft": 20,
    "paddingRight": 20,
    "paddingTop": 12
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "orientation": "vertical"
      },
      "children": [
        {
          "tag": "ConstraintLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "paddingTop": 6,
            "paddingBottom": 6
          },
          "children": [
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_add_group_title",
                "layout_width": 0,
                "layout_height": "wrap_content",
                "text": "添加分组",
                "textColor": "#de000000",
                "layout_constraintTop_toTopOf": "parent",
                "layout_constraintLeft_toLeftOf": "parent",
                "layout_constraintRight_toLeftOf": "@+id/sw_add_group"
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_add_group_s",
                "layout_width": 0,
                "layout_height": "wrap_content",
                "text": "关闭替换分组/开启添加分组",
                "textColor": "#8a000000",
                "layout_constraintTop_toBottomOf": "@+id/tv_add_group_title",
                "layout_constraintLeft_toLeftOf": "parent",
                "layout_constraintRight_toLeftOf": "@+id/sw_add_group"
              },
              "children": []
            },
            {
              "tag": "ThemeSwitch",
              "attrs": {
                "id": "sw_add_group",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "layout_constraintBottom_toBottomOf": "parent",
                "layout_constraintRight_toRightOf": "parent",
                "layout_constraintTop_toTopOf": "parent"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "TextInputLayout",
          "attrs": {
            "id": "text_input_layout",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "paddingTop": 6
          },
          "children": [
            {
              "tag": "AutoCompleteTextView",
              "attrs": {
                "id": "edit_view",
                "layout_width": "match_parent",
                "layout_height": "wrap_content"
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}