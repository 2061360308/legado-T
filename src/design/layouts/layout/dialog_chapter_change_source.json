{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "background": "@color/background"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "@color/background_menu",
        "layout_constraintTop_toTopOf": "parent"
      },
      "children": []
    },
    {
      "tag": "RefreshProgressBar",
      "attrs": {
        "id": "refresh_progress_bar",
        "layout_width": "match_parent",
        "layout_height": 2,
        "layout_constraintTop_toBottomOf": "@+id/tool_bar"
      },
      "children": []
    },
    {
      "tag": "FastScrollRecyclerView",
      "attrs": {
        "id": "recycler_view",
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_constraintBottom_toTopOf": "@+id/ll_bottom_bar",
        "layout_constraintTop_toBottomOf": "@+id/refresh_progress_bar"
      },
      "children": []
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "ll_bottom_bar",
        "layout_width": "match_parent",
        "layout_height": 36,
        "background": "@color/background",
        "gravity": "center_vertical",
        "orientation": "horizontal",
        "paddingLeft": 10,
        "paddingRight": 10,
        "layout_constraintBottom_toBottomOf": "parent"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_dur",
            "layout_width": 0,
            "layout_height": "match_parent",
            "layout_weight": "1",
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "ellipsize": "middle",
            "gravity": "center_vertical",
            "paddingLeft": 10,
            "paddingRight": 10,
            "singleLine": "true",
            "textColor": "#de000000",
            "textSize": 12
          },
          "children": []
        },
        {
          "tag": "AppCompatImageView",
          "attrs": {
            "id": "iv_top",
            "layout_width": 36,
            "layout_height": "match_parent",
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "contentDescription": "滚动到顶部",
            "src": "ic_arrow_drop_up",
            "tint": "#de000000"
          },
          "children": []
        },
        {
          "tag": "AppCompatImageView",
          "attrs": {
            "id": "iv_bottom",
            "layout_width": 36,
            "layout_height": "match_parent",
            "background": "?android:attr/selectableItemBackgroundBorderless",
            "contentDescription": "滚动到底部",
            "src": "ic_arrow_drop_down",
            "tint": "#de000000"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "ConstraintLayout",
      "attrs": {
        "id": "cl_toc",
        "layout_width": "match_parent",
        "layout_height": 0,
        "background": "@color/background",
        "visibility": "gone",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintTop_toBottomOf": "@+id/tool_bar"
      },
      "children": [
        {
          "tag": "FrameLayout",
          "attrs": {
            "id": "fl_hide_toc",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "background": "@color/background",
            "layout_constraintTop_toTopOf": "parent"
          },
          "children": [
            {
              "tag": "ImageFilterView",
              "attrs": {
                "id": "iv_hide_toc",
                "layout_width": "match_parent",
                "layout_height": 36,
                "background": "?android:attr/selectableItemBackground",
                "src": "ic_arrow_down",
                "tint": "#de000000"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "RecyclerView",
          "attrs": {
            "id": "recycler_view_toc",
            "layout_width": "match_parent",
            "layout_height": 0,
            "layout_constraintBottom_toBottomOf": "parent",
            "layout_constraintTop_toBottomOf": "@+id/fl_hide_toc"
          },
          "children": []
        },
        {
          "tag": "RotateLoading",
          "attrs": {
            "id": "loading_toc",
            "layout_width": 48,
            "layout_height": 48,
            "visibility": "gone",
            "layout_constraintBottom_toBottomOf": "@+id/recycler_view_toc",
            "layout_constraintLeft_toLeftOf": "@+id/recycler_view_toc",
            "layout_constraintRight_toRightOf": "@+id/recycler_view_toc",
            "layout_constraintTop_toTopOf": "@+id/recycler_view_toc"
          },
          "children": []
        }
      ]
    }
  ]
}