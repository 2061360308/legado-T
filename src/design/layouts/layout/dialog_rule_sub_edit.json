{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical",
    "padding": 16
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
