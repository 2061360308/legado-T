{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "gravity": "center_vertical",
    "orientation": "horizontal",
    "paddingLeft": 16,
    "paddingTop": 6,
    "paddingRight": 8,
    "paddingBottom": 6
  },
  "children": [
    {
      "tag": "ThemeCheckBox",
      "attrs": {
        "id": "cb_selected_all",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_weight": "1",
        "padding": 5,
        "text": "全选"
      },
      "children": []
    },
    {
      "tag": "AccentStrokeTextView",
      "attrs": {
        "id": "btn_revert_selection",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_margin": 5,
        "gravity": "center",
        "padding": 5,
        "text": "反选"
      },
      "children": []
    },
    {
      "tag": "AccentStrokeTextView",
      "attrs": {
        "id": "btn_select_action_main",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_margin": 5,
        "gravity": "center",
        "padding": 5,
        "text": "阅读",
        "visibility": "gone"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_menu_more",
        "layout_width": 36,
        "layout_height": 36,
        "background": "?attr/selectableItemBackgroundBorderless",
        "contentDescription": "更多菜单",
        "padding": 6,
        "src": "ic_more_vert",
        "tint": "#de000000",
        "visibility": "gone"
      },
      "children": []
    }
  ]
}