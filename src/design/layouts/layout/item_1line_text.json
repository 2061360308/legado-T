{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "gravity": "center_vertical",
    "orientation": "horizontal",
    "padding": 6,
    "background": "?attr/selectableItemBackground"
  },
  "children": [
    {
      "tag": "TextView",
      "attrs": {
        "id": "text_view",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_weight": "1",
        "singleLine": "true",
        "textColor": "#de000000"
      },
      "children": []
    }
  ]
}