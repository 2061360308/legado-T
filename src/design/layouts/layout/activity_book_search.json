{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_constraintTop_toTopOf": "parent",
        "title": "搜索"
      },
      "children": []
    },
    {
      "tag": "RefreshProgressBar",
      "attrs": {
        "id": "refresh_progress_bar",
        "layout_width": "match_parent",
        "layout_height": 2,
        "layout_constraintTop_toBottomOf": "@id/title_bar"
      },
      "children": []
    },
    {
      "tag": "DynamicFrameLayout",
      "attrs": {
        "id": "content_view",
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintTop_toBottomOf": "@id/refresh_progress_bar"
      },
      "children": [
        {
          "tag": "RecyclerView",
          "attrs": {
            "id": "recycler_view",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "ll_input_help",
        "layout_width": "match_parent",
        "layout_height": 0,
        "background": "@color/background",
        "orientation": "vertical",
        "visibility": "gone",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintTop_toBottomOf": "@id/title_bar"
      },
      "children": [
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_book_show",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "padding": 6,
            "text": "书架",
            "visibility": "gone"
          },
          "children": []
        },
        {
          "tag": "RecyclerView",
          "attrs": {
            "id": "rv_bookshelf_search",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "visibility": "gone"
          },
          "children": []
        },
        {
          "tag": "RecyclerView",
          "attrs": {
            "id": "rv_history_key",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        },
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_history",
                "layout_width": 0,
                "layout_height": "wrap_content",
                "layout_weight": "1",
                "padding": 6,
                "text": "搜索历史"
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_clear_history",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "background": "?attr/selectableItemBackground",
                "padding": 6,
                "text": "清除"
              },
              "children": []
            }
          ]
        }
      ]
    },
    {
      "tag": "FloatingActionButton",
      "attrs": {
        "id": "fb_start_stop",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_margin": 16,
        "contentDescription": "停止",
        "src": "ic_stop_black_24dp",
        "visibility": "invisible",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    }
  ]
}