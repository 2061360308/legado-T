                  "children": []
                },
                {
                  "tag": "TextView",
                  "attrs": {
                    "id": "text_xt",
                    "layout_width": "wrap_content",
                    "layout_height": "wrap_content",
                    "layout_margin": 3,
                    "background": "selector_fillet_btn_bg",
