{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "@color/background_menu",
        "title": "编辑分组"
      },
      "children": []
    },
    {
      "tag": "ConstraintLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "background": "@color/background_menu"
      },
      "children": [
        {
          "tag": "CoverImageView",
          "attrs": {
            "id": "iv_cover",
            "layout_width": 90,
            "layout_height": 126,
            "layout_margin": 6,
            "contentDescription": "封面",
            "scaleType": "centerCrop",
            "src": "image_cover_default",
            "layout_constraintBottom_toBottomOf": "parent",
            "layout_constraintLeft_toLeftOf": "parent",
            "layout_constraintTop_toTopOf": "parent"
          },
          "children": []
        },
        {
          "tag": "TextInputLayout",
          "attrs": {
            "id": "til_group_name",
            "layout_width": 0,
            "layout_height": "wrap_content",
            "layout_margin": 6,
            "hint": "分组名称",
            "layout_constraintBottom_toTopOf": "@+id/tv_sort",
            "layout_constraintLeft_toRightOf": "@+id/iv_cover",
            "layout_constraintRight_toRightOf": "parent",
            "layout_constraintTop_toTopOf": "parent"
          },
          "children": [
            {
              "tag": "ThemeEditText",
              "attrs": {
                "id": "tie_group_name",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "maxLines": "2"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_sort",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 3,
            "text": "排序",
            "textColor": "#de000000",
            "layout_constraintLeft_toLeftOf": "@id/til_group_name",
            "layout_constraintTop_toBottomOf": "@id/til_group_name"
          },
          "children": []
        },
        {
          "tag": "AppCompatSpinner",
          "attrs": {
            "id": "sp_sort",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginLeft": 6,
            "layout_constraintBottom_toBottomOf": "@id/tv_sort",
            "layout_constraintLeft_toRightOf": "@+id/tv_sort",
            "layout_constraintTop_toTopOf": "@id/tv_sort"
          },
          "children": []
        },
        {
          "tag": "ThemeCheckBox",
          "attrs": {
            "id": "cb_enable_refresh",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "text": "允许下拉刷新",
            "checked": "true",
            "layout_constraintTop_toBottomOf": "@+id/tv_sort",
            "layout_constraintLeft_toLeftOf": "@id/tv_sort"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "orientation": "horizontal",
        "gravity": "center_vertical"
      },
      "children": [
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "btn_delete",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_margin": 12,
            "padding": 6,
            "text": "删除"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "btn_cancel",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_margin": 12,
            "padding": 6,
            "text": "取消"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "btn_ok",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_margin": 12,
            "padding": 6,
            "text": "确认"
          },
          "children": []
        },
        {
          "tag": "Space",
          "attrs": {
            "layout_width": 0,
            "layout_height": 1,
            "layout_weight": "1"
          },
          "children": []
        }
      ]
    }
  ]
}