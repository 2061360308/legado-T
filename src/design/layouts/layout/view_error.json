{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "wrap_content",
    "layout_height": "wrap_content",
    "gravity": "center_horizontal",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_error_image",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content"
      },
      "children": []
    },
    {
      "tag": "AppCompatTextView",
      "attrs": {
        "id": "tv_error_message",
        "style": "@style/Style.Text.Primary.Normal",
        "paddingTop": 16,
        "paddingBottom": 16
      },
      "children": []
    },
    {
      "tag": "AppCompatButton",
      "attrs": {
        "id": "btn_error_retry",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "text": "点击重试"
      },
      "children": []
    }
  ]
}