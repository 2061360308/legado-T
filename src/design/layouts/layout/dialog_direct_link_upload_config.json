{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "Toolbar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "title": "直链上传配置"
      },
      "children": []
    },
    {
      "tag": "NestedScrollView",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_weight": "1"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "orientation": "vertical",
            "padding": 16
          },
          "children": [
            {
              "tag": "TextInputLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "paddingTop": 3
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "edit_upload_url",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "上传 URL"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "paddingTop": 3
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "edit_download_url_rule",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "下载URL规则(downloadUrls)"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "TextInputLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "paddingTop": 3
              },
              "children": [
                {
                  "tag": "ThemeEditText",
                  "attrs": {
                    "id": "edit_summary",
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "注释"
                  },
                  "children": []
                }
              ]
            },
            {
              "tag": "ThemeCheckBox",
              "attrs": {
                "id": "cb_compress",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "minHeight": 48,
                "text": "是否压缩"
              },
              "children": []
            }
          ]
        }
      ]
    },
    {
      "tag": "FlexboxLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingLeft": 12,
        "paddingRight": 12
      },
      "children": [
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_footer_left",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 12,
            "text": "测试"
          },
          "children": []
        },
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "AccentTextView",
              "attrs": {
                "id": "tv_cancel",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 12,
                "text": "取消"
              },
              "children": []
            },
            {
              "tag": "AccentTextView",
              "attrs": {
                "id": "tv_ok",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 12,
                "text": "确认"
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}