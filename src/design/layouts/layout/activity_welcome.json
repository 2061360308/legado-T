{
  "tag": "ConstraintLayout",
  "attrs": {
    "orientation": "vertical",
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "gravity": "center_horizontal"
  },
  "children": [
    {
      "tag": "ConstraintLayout",
      "attrs": {
        "id": "tv_legado",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_constraintVertical_bias": "0.4",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent",
        "layout_constraintTop_toTopOf": "parent",
        "layout_constraintBottom_toTopOf": "@+id/iv_book"
      },
      "children": [
        {
          "tag": "View",
          "attrs": {
            "id": "vw_title_line",
            "layout_width": 6,
            "layout_height": 0,
            "background": "@color/accent",
            "layout_constraintTop_toTopOf": "@+id/tv_title",
            "layout_constraintBottom_toBottomOf": "@+id/tv_title",
            "layout_constraintLeft_toLeftOf": "parent"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_title",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginLeft": 6,
            "text": "阅读",
            "textSize": 49,
            "layout_constraintRight_toLeftOf": "@+id/tv_sub_title",
            "layout_constraintLeft_toRightOf": "@+id/vw_title_line",
            "layout_constraintTop_toTopOf": "parent"
          },
          "children": []
        },
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_sub_title",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_marginTop": 60,
            "layout_marginLeft": 6,
            "text": "享受美好时光",
            "textSize": 16,
            "layout_constraintTop_toTopOf": "@+id/tv_title",
            "layout_constraintLeft_toRightOf": "@id/tv_title"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "ImageView",
      "attrs": {
        "id": "iv_book",
        "layout_width": 120,
        "layout_height": 120,
        "layout_marginBottom": 32,
        "src": "icon_read_book",
        "scaleType": "fitCenter",
        "contentDescription": "启动页",
        "layout_constraintBottom_toTopOf": "@+id/tv_gzh",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    },
    {
      "tag": "AccentTextView",
      "attrs": {
        "id": "tv_gzh",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "text": "关注公众号[开源阅读]\\n看文章点广告支持作者",
        "layout_marginBottom": 32,
        "gravity": "center_horizontal",
        "layout_constraintBottom_toBottomOf": "parent",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    }
  ]
}