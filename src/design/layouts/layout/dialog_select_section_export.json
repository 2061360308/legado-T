{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "padding": 16
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "match_parent",
        "orientation": "vertical"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginTop": 12,
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "SmoothCheckBox",
              "attrs": {
                "id": "cb_all_export",
                "layout_width": 20,
                "layout_height": 20,
                "layout_gravity": "center",
                "layout_marginStart": 6,
                "layout_marginEnd": 16
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_all_export",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "text": "导出所有",
                "textSize": 18
              },
              "children": []
            }
          ]
        },
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginTop": 12,
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "SmoothCheckBox",
              "attrs": {
                "id": "cb_select_export",
                "layout_width": 20,
                "layout_height": 20,
                "layout_gravity": "center",
                "layout_marginStart": 6,
                "layout_marginEnd": 16
              },
              "children": []
            },
            {
              "tag": "TextView",
              "attrs": {
                "id": "tv_select_export",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "text": "自定义导出",
                "textSize": 18
              },
              "children": []
            }
          ]
        },
        {
          "tag": "TextInputLayout",
          "attrs": {
            "id": "ly_et_epub_filename",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginTop": 12,
            "hint": "导出文件名"
          },
          "children": [
            {
              "tag": "ThemeEditText",
              "attrs": {
                "id": "et_epub_filename",
                "layout_width": "match_parent",
                "layout_height": "wrap_content"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "TextInputLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginTop": 12,
            "hint": "每个文件包含的章节数量"
          },
          "children": [
            {
              "tag": "ThemeEditText",
              "attrs": {
                "id": "et_epub_size",
                "layout_width": "match_parent",
                "layout_height": "wrap_content"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "TextInputLayout",
          "attrs": {
            "id": "ly_et_input_scope",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "hint": "需要输出的章节"
          },
          "children": [
            {
              "tag": "ThemeEditText",
              "attrs": {
                "id": "et_input_scope",
                "layout_width": "match_parent",
                "layout_height": "wrap_content"
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}