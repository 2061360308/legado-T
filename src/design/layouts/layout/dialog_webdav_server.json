{
  "tag": "FrameLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "padding": 16
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "id": "vw_bg",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "background": "shape_card_view",
        "orientation": "vertical"
      },
      "children": [
        {
          "tag": "Toolbar",
          "attrs": {
            "id": "tool_bar",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_marginBottom": 3,
            "background": "@color/background_menu",
            "title": "服务器配置"
          },
          "children": []
        },
        {
          "tag": "TextInputLayout",
          "attrs": {
            "id": "til_name",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "hint": "名称"
          },
          "children": [
            {
              "tag": "ThemeEditText",
              "attrs": {
                "id": "et_name",
                "layout_width": "match_parent",
                "layout_height": "wrap_content"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "orientation": "horizontal",
            "gravity": "center_vertical"
          },
          "children": [
            {
              "tag": "AccentTextView",
              "attrs": {
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 6,
                "text": "TYPE"
              },
              "children": []
            },
            {
              "tag": "AppCompatSpinner",
              "attrs": {
                "id": "sp_type",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content"
              },
              "children": []
            }
          ]
        },
        {
          "tag": "NestedScrollView",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content"
          },
          "children": [
            {
              "tag": "FlexboxLayout",
              "attrs": {
                "id": "flexbox",
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "layout_marginTop": 8,
                "padding": 3
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}