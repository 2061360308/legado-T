{
  "tag": "ConstraintLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content"
  },
  "children": [
    {
      "tag": "ImageView",
      "attrs": {
        "id": "image_view",
        "layout_width": 0,
        "layout_height": 220,
        "contentDescription": "加载中…",
        "visibility": "visible",
        "scaleType": "centerCrop",
        "paddingTop": 12,
        "paddingRight": 12,
        "paddingLeft": 12,
        "layout_constraintTop_toTopOf": "parent",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_title",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "maxLines": "2",
        "ellipsize": "end",
        "text": "阅读",
        "textColor": "#de000000",
        "textSize": 15,
        "textStyle": "bold",
        "paddingLeft": 12,
        "paddingRight": 12,
        "paddingTop": 12,
        "layout_constraintTop_toBottomOf": "@+id/image_view",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    },
    {
      "tag": "TextView",
      "attrs": {
        "id": "tv_pub_date",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "text": "阅读",
        "textSize": 11,
        "maxLines": "1",
        "paddingLeft": 12,
        "paddingRight": 12,
        "paddingTop": 10,
        "layout_constraintTop_toBottomOf": "@+id/tv_title",
        "layout_constraintLeft_toLeftOf": "parent",
        "layout_constraintRight_toRightOf": "parent"
      },
      "children": []
    },
    {
      "tag": "View",
      "attrs": {
        "layout_marginTop": 12,
        "layout_constraintTop_toBottomOf": "@+id/tv_pub_date",
        "layout_height": 8,
        "layout_width": "match_parent",
        "background": "@color/bg_divider_line"
      },
      "children": []
    }
  ]
}