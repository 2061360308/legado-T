{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "tool_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": []
    },
    {
      "tag": "FrameLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": 0,
        "layout_weight": "1"
      },
      "children": [
        {
          "tag": "FastScrollRecyclerView",
          "attrs": {
            "id": "recycler_view",
            "layout_width": "match_parent",
            "layout_height": "match_parent"
          },
          "children": []
        },
        {
          "tag": "RotateLoading",
          "attrs": {
            "id": "rotate_loading",
            "layout_width": 36,
            "layout_height": 36,
            "layout_gravity": "center",
            "layout_margin": 6,
            "visibility": "gone"
          },
          "children": []
        },
        {
          "tag": "TextView",
          "attrs": {
            "id": "tv_msg",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "layout_gravity": "center",
            "padding": 16,
            "textColor": "#8a000000",
            "visibility": "gone"
          },
          "children": []
        }
      ]
    },
    {
      "tag": "FlexboxLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "paddingLeft": 12,
        "paddingRight": 12
      },
      "children": [
        {
          "tag": "AccentTextView",
          "attrs": {
            "id": "tv_footer_left",
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "padding": 12,
            "visibility": "gone"
          },
          "children": []
        },
        {
          "tag": "Space",
          "attrs": {
            "layout_width": 0,
            "layout_height": 0
          },
          "children": []
        },
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "AccentTextView",
              "attrs": {
                "id": "tv_cancel",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 12,
                "text": "取消",
                "visibility": "gone"
              },
              "children": []
            },
            {
              "tag": "AccentTextView",
              "attrs": {
                "id": "tv_ok",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "padding": 12,
                "text": "确认",
                "visibility": "gone"
              },
              "children": []
            }
          ]
        }
      ]
    }
  ]
}