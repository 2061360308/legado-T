{
  "tag": "FrameLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "padding": 16
  },
  "children": [
    {
      "tag": "LinearLayout",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "background": "shape_card_view",
        "orientation": "vertical"
      },
      "children": [
        {
          "tag": "Toolbar",
          "attrs": {
            "id": "tool_bar",
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "background": "@color/background_menu",
            "title": "字典规则"
          },
          "children": []
        },
        {
          "tag": "NestedScrollView",
          "attrs": {
            "layout_width": "match_parent",
            "layout_height": "wrap_content",
            "paddingTop": 6
          },
          "children": [
            {
              "tag": "LinearLayout",
              "attrs": {
                "layout_width": "match_parent",
                "layout_height": "wrap_content",
                "orientation": "vertical"
              },
              "children": [
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "名称"
                  },
                  "children": [
                    {
                      "tag": "ThemeEditText",
                      "attrs": {
                        "id": "tv_rule_name",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "url规则(urlRule)"
                  },
                  "children": [
                    {
                      "tag": "ThemeEditText",
                      "attrs": {
                        "id": "tv_url_rule",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                },
                {
                  "tag": "TextInputLayout",
                  "attrs": {
                    "layout_width": "match_parent",
                    "layout_height": "wrap_content",
                    "hint": "显示规则(showRule)"
                  },
                  "children": [
                    {
                      "tag": "ThemeEditText",
                      "attrs": {
                        "id": "tv_show_rule",
                        "layout_width": "match_parent",
                        "layout_height": "wrap_content"
                      },
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}