{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "wrap_content",
    "background": "?android:attr/selectableItemBackground",
    "gravity": "center_vertical",
    "orientation": "horizontal",
    "padding": 16
  },
  "children": [
    {
      "tag": "ThemeCheckBox",
      "attrs": {
        "id": "cb_source",
        "layout_width": 0,
        "layout_height": "wrap_content",
        "layout_gravity": "center",
        "layout_weight": "1",
        "singleLine": "true",
        "textColor": "#de000000"
      },
      "children": []
    },
    {
      "tag": "ThemeSwitch",
      "attrs": {
        "id": "swt_enabled",
        "layout_width": "wrap_content",
        "layout_height": "wrap_content",
        "layout_marginLeft": 6,
        "layout_marginRight": 6
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_edit",
        "layout_width": 36,
        "layout_height": 36,
        "layout_gravity": "center",
        "background": "?android:attr/selectableItemBackgroundBorderless",
        "contentDescription": "编辑",
        "padding": 6,
        "src": "ic_edit",
        "tint": "#de000000"
      },
      "children": []
    },
    {
      "tag": "AppCompatImageView",
      "attrs": {
        "id": "iv_menu_more",
        "layout_width": 36,
        "layout_height": 36,
        "background": "?attr/selectableItemBackgroundBorderless",
        "contentDescription": "更多菜单",
        "padding": 6,
        "src": "ic_more_vert",
        "tint": "#de000000"
      },
      "children": []
    }
  ]
}