{
  "tag": "LinearLayout",
  "attrs": {
    "layout_width": "match_parent",
    "layout_height": "match_parent",
    "orientation": "vertical"
  },
  "children": [
    {
      "tag": "TitleBar",
      "attrs": {
        "id": "title_bar",
        "layout_width": "match_parent",
        "layout_height": "wrap_content",
        "title": "编辑订阅源"
      },
      "children": []
    },
    {
      "tag": "HorizontalScrollView",
      "attrs": {
        "layout_width": "match_parent",
        "layout_height": "wrap_content"
      },
      "children": [
        {
          "tag": "LinearLayout",
          "attrs": {
            "layout_width": "wrap_content",
            "layout_height": "wrap_content",
            "layout_gravity": "center_vertical",
            "orientation": "horizontal"
          },
          "children": [
            {
              "tag": "ThemeCheckBox",
              "attrs": {
                "id": "cb_is_enable",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "checked": "true",
                "text": "启用"
              },
              "children": []
            },
            {
              "tag": "ThemeCheckBox",
              "attrs": {
                "id": "cb_single_url",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "checked": "false",
                "text": "单 URL"
              },
              "children": []
            },
            {
              "tag": "ThemeCheckBox",
              "attrs": {
                "id": "cb_is_enable_cookie",
                "layout_width": "wrap_content",
                "layout_height": "wrap_content",
                "checked": "true",
                "text": "CookieJar"
              },
              "children": []
            }
          ]
        }
      ]
    },
    {
      "tag": "TabLayout",
      "attrs": {
        "id": "tab_layout",
        "layout_width": "match_parent",
        "layout_height": 36,
        "background": "@color/background"
      },
      "children": []
    },
    {
      "tag": "RecyclerView",
      "attrs": {
        "id": "recycler_view",
        "layout_width": "match_parent",
        "layout_height": "match_parent"
      },
      "children": []
    }
  ]
}